# =============================================================================
# Autonomous SEO Agent OS — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-random-secret-key-in-production

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# -----------------------------------------------------------------------------
# Database — PostgreSQL (primary)
# -----------------------------------------------------------------------------
# Async connection string (for SQLAlchemy async + asyncpg)
DATABASE_URL=postgresql+asyncpg://seo_user:seo_pass@localhost:5432/seo_agent_os

# Sync connection string (for Alembic migrations, Celery)
SYNC_DATABASE_URL=postgresql://seo_user:seo_pass@localhost:5432/seo_agent_os

# Connection pool settings
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# -----------------------------------------------------------------------------
# Database — SQLite (MVP fallback only)
# -----------------------------------------------------------------------------
# Set USE_SQLITE=true to use SQLite instead of PostgreSQL.
# DO NOT use SQLite in production.
USE_SQLITE=false
SQLITE_DATABASE_URL=sqlite:///./seo_agent_os.db

# -----------------------------------------------------------------------------
# Redis — Celery / RQ broker
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# Celery settings (if using Celery)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json
CELERY_TIMEZONE=UTC
CELERY_ENABLE_UTC=true

# -----------------------------------------------------------------------------
# Hermes AI Agent
# -----------------------------------------------------------------------------
# Primary AI backend for the agentic system
HERMES_API_KEY=your_hermes_api_key_here
HERMES_ENDPOINT=http://localhost:8080
HERMES_MODEL=minimax/minimax-m2.7
HERMES_TIMEOUT=120

# Model routing — override defaults per task type
# CHEAP: extraction, parsing, batch metric computation
HERMES_MODEL_CHEAP=minimax/minimax-m2
# STRONG: strategy, content generation, editorial review
HERMES_MODEL_STRONG=minimax/minimax-m2.7

# -----------------------------------------------------------------------------
# OpenAI (optional — model override for specific tasks)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_ORG_ID=your_org_id_here
OPENAI_API_BASE=https://api.openai.com/v1

# -----------------------------------------------------------------------------
# Anthropic (optional)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# -----------------------------------------------------------------------------
# Google APIs
# -----------------------------------------------------------------------------
# Google Search Console (for integrations)
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_SEARCH_CONSOLE_CLIENT_ID=your_gsc_client_id_here
GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=your_gsc_client_secret_here
GOOGLE_SEARCH_CONSOLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Google Analytics 4
GA4_PROPERTY_ID=your_ga4_property_id_here
GA4_CREDENTIALS_PATH=./credentials/ga4_credentials.json

# Google PageSpeed Insights
PAGESPEED_API_KEY=your_pagespeed_api_key_here

# -----------------------------------------------------------------------------
# WordPress Integration
# -----------------------------------------------------------------------------
WORDPRESS_API_URL=https://your-site.com/wp-json/wp/v2
WORDPRESS_USERNAME=your_wp_username
WORDPRESS_APP_PASSWORD=your_wp_app_password

# -----------------------------------------------------------------------------
# GitHub Integration
# -----------------------------------------------------------------------------
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_OWNER=your_github_username_or_org
GITHUB_REPO=your_repo_name
GITHUB_BRANCH=main

# -----------------------------------------------------------------------------
# File Storage
# -----------------------------------------------------------------------------
# Root directory for all storage (reports, exports, crawl snapshots)
STORAGE_PATH=./storage

# Individual storage paths (relative to STORAGE_PATH or absolute)
REPORTS_PATH=./storage/reports
EXPORTS_PATH=./storage/exports
CRAWL_SNAPSHOTS_PATH=./storage/crawl-snapshots
CONTENT_DRAFTS_PATH=./storage/content-drafts
SCHEMA_OUTPUT_PATH=./storage/schemas

# Screenshot storage
SCREENSHOTS_PATH=./storage/screenshots
SCREENSHOT_FORMAT=webp
SCREENSHOT_QUALITY=85

# -----------------------------------------------------------------------------
# Crawler Settings
# -----------------------------------------------------------------------------
CRAWL_MAX_PAGES=100
CRAWL_MAX_DEPTH=3
CRAWL_REQUEST_DELAY_MS=1000
CRAWL_USER_AGENT=Mozilla/5.0 (compatible; SEOAgentOS/1.0; +https://example.com/bot)
CRAWL_FOLLOW_ROBOTS_TXT=true
CRAWL_RESPECT_NOINDEX=false
CRAWL_SNAPSHOT_HTML=true
CRAWL_TIMEOUT_SECONDS=30

# -----------------------------------------------------------------------------
# Content Engine Settings
# -----------------------------------------------------------------------------
# Max content length (words)
CONTENT_MAX_WORDS=3000
CONTENT_MIN_WORDS=300

# Brand voice — path to brand voice definition file
BRAND_VOICE_PATH=./config/brand_voice.md

# Content approval required before publishing
CONTENT_REQUIRE_APPROVAL=true

# Allowed content topics (blocklist for restricted content)
CONTENT_ALLOWED_TOPICS=general,local_business,technology,automotive,cannabis
# Cannabis topics require extra compliance checks (enforced regardless)
CANNABIS_CONTENT_ENABLED=true

# -----------------------------------------------------------------------------
# SEO Audit Settings
# -----------------------------------------------------------------------------
# Minimum word count before flagging as thin content
THIN_CONTENT_WORD_COUNT=150

# H1 conflict threshold (flag if multiple H1s per page)
H1_MAX_PER_PAGE=1

# Meta description length thresholds
META_DESC_MIN_CHARS=50
META_DESC_MAX_CHARS=160

# Title tag length thresholds
TITLE_TAG_MIN_CHARS=15
TITLE_TAG_MAX_CHARS=60

# -----------------------------------------------------------------------------
# GEO Audit Settings
# -----------------------------------------------------------------------------
# Entity clarity minimum score to pass
GEO_ENTITY_CLARITY_MIN=60

# llms.txt generation enabled
LLMS_TXT_ENABLED=true
LLMS_TXT_OUTPUT_PATH=./storage/llms.txt

# AI crawler user agents to check
AI_CRAWLER_UA="CCBot/2.0 (https://commoncrawl.org/faq/)"
AI_CRAWLER_UA_2="anthropic-ai/1.0"
AI_CRAWLER_UA_3="Claude/1.0"

# -----------------------------------------------------------------------------
# Reporting
# -----------------------------------------------------------------------------
# Report format: markdown, pdf
REPORT_DEFAULT_FORMAT=markdown
REPORT_OUTPUT_PATH=./storage/reports

# Executive summary word count limit
REPORT_EXECUTIVE_SUMMARY_MAX_WORDS=250

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
# External API rate limits
GSC_RATE_LIMIT_REQUESTS_PER_SECOND=10
GA4_RATE_LIMIT_REQUESTS_PER_SECOND=10
PAGESPEED_RATE_LIMIT_PER_MINUTE=60

# Internal rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# JWT settings
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Admin API key (for CLI/scripts)
ADMIN_API_KEY=change-me-in-production

# -----------------------------------------------------------------------------
# Monitoring & Observability
# -----------------------------------------------------------------------------
# Sentry error tracking (optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# Health check
HEALTH_CHECK_ENABLED=true

# Metrics (Prometheus-compatible)
METRICS_ENABLED=true
METRICS_PORT=9090
